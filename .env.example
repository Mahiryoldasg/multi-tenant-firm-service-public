# Local configuration. You do not need to copy this file by hand:
# `npm start` / `npm run dev` create .env from it on first run and generate JWT_SECRET.
# .env is git-ignored; secrets never live in code.

PORT=4000
# Leave empty: scripts/ensure-env.mjs fills it with a random value in .env.
JWT_SECRET=
DB_PATH=./data/app.db
USER_TOKEN_TTL=12h
LOG_LEVEL=info

# Seed data, used only on the very first boot of an empty database (documented in README).
SEED_PLATFORM_ADMIN_EMAIL=admin@platform.local
SEED_PLATFORM_ADMIN_PASSWORD=PlatformAdmin!2026
SEED_FIRM1_NAME="Acme Fuarcılık"
SEED_FIRM1_ADMIN_EMAIL=admin@acme.local
SEED_FIRM1_ADMIN_PASSWORD=AcmeAdmin!2026
SEED_FIRM2_NAME="Globex Etkinlik"
SEED_FIRM2_ADMIN_EMAIL=admin@globex.local
SEED_FIRM2_ADMIN_PASSWORD=GlobexAdmin!2026
